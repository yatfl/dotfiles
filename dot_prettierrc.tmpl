{
  "printWidth": 80,
  "proseWrap": "always",
  "tabWidth": 4,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-glsl"],
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.glsl", "*.vert", "*.frag"],
      "options": {
        "parser": "glsl-parser"
      }
    }
  ]
}
